// "Remove 'value' modifier" "true"
// WITH_STDLIB
// K2_ERROR: VALUE_CLASS_CANNOT_EXTEND_IDENTITY_CLASSES
// COMPILER_ARGUMENTS: -XXLanguage:+FullValueClasses
abstract class Base {
    abstract fun f(): Int
    open val g: Int get() = 0
    open fun h(): Int = 0
}

class V(val v: Int) : Base() {
    override fun f(): Int = super.h() + v
    override val g: Int get() = v
}

val asBase: Base = V(1)

// FUS_QUICKFIX_NAME: org.jetbrains.kotlin.idea.quickfix.RemoveModifierFixBase
