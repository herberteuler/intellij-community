load("@bazel_skylib//rules:common_settings.bzl", "string_list_flag")
load("@rules_java//java:defs.bzl", "java_binary")
load("@rules_jvm//:jvm-args.bzl", "get_jvm_flags")
load("@rules_jvm//:jvm.bzl", "scrubbed_host_tool")
load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_library")

# The packager runs as a Bazel persistent worker: `ij_plugin.bzl` launches the `ij-plugin-packager_deploy.jar` implicit output of this
# target, so JVM options are specified in `:ij-plugin-packager-jvm_flags` below instead of `jvm_flags` here.
java_binary(
    name = "ij-plugin-packager",
    main_class = "com.intellij.tools.build.bazel.ijPluginPackager.IjPluginPackager",
    visibility = ["//visibility:public"],
    runtime_deps = [":ij-plugin-packager-lib"],
)

# `ij_plugin.bzl` names this target in an attribute with `cfg = "exec"`: the packager is built once per execution
# platform, not once per configuration of the plugins it packs, and the scrubbed host platform behind this target
# gives the deploy jar a host-independent output directory (see `scrubbed_host_tool` in `@rules_jvm//:jvm.bzl`).
scrubbed_host_tool(
    name = "ij-plugin-packager-scrubbed_host_tool",
    # Reached through the exec edge of ij_plugin only: a wildcard pattern must not build it at the top level, in the
    # target configuration, which would add a second copy of the packager.
    tags = ["manual"],
    tool = ":ij-plugin-packager_deploy.jar",
    visibility = ["//visibility:public"],
)

# JVM options for the packager worker process; shared with the other workers of `@rules_jvm` via `get_jvm_flags`.
string_list_flag(
    name = "ij-plugin-packager-jvm_flags",
    build_setting_default = get_jvm_flags([
        # required by the memory-mapped ZIP reader used to read and write JARs
        "--add-opens=java.base/jdk.internal.ref=ALL-UNNAMED",
        "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED",
        # packaging needs far less heap than compilation; the last `-Xmx` wins, so this overrides the default from `get_jvm_flags`
        "-Xmx512m",
    ]),
    visibility = ["//visibility:public"],
)

kt_jvm_library(
    name = "ij-plugin-packager-lib",
    srcs = glob(["src/**/*.kt"]),
    kotlinc_opts = "@rules_jvm//:rules_jvm_bootstrap_kotlinc_options",
    visibility = ["//platform/build-scripts/bazel-rules/ij-plugin-packager/tests:__pkg__"],
    deps = [
        "//platform/pluginSystem/parser/impl",
        "@community//build:zip",
        "@community//platform/util",
        "@community//platform/util/jdom",
        "@rules_jvm//:annotations_import",
        "@rules_jvm//:kotlinx-coroutines-core_import",
        "@rules_jvm//:opentelemetry-api_import",
        "@rules_jvm//worker-framework",
    ],
)
