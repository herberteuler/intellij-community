+def _cc_common_link_strip_level(ctx, attr, toolchain, crate_info, compilation_mode, rust_flags):
+    """The `-Cstrip` level that rustc would apply to the output of its own link.
+
+    `construct_arguments` passes the level of the compilation mode first, then the extra flags, `rust_flags`, and the
+    `rustc_flags` of the target. rustc takes the last level, so take it too.
+
+    Args:
+        ctx (ctx): The context of the current target.
+        attr (struct): The attributes of the current target.
+        toolchain (rust_toolchain): The current Rust toolchain.
+        crate_info (CrateInfo): The crate of the link.
+        compilation_mode (struct): The options of the compilation mode.
+        rust_flags (list or Args): The flags that the rule adds. The level in an `Args` is not visible here.
 
+    Returns:
+        str: `none`, `debuginfo`, or `symbols`.
+    """
+    flags = collect_extra_rustc_flags(ctx, toolchain, crate_info.root, crate_info.type)
+    if type(rust_flags) != "Args":
+        flags = flags + rust_flags
+    flags = flags + getattr(attr, "rustc_flags", [])
+
+    strip_level = compilation_mode.strip_level
+    codegen_option_follows = False
+    for flag in flags:
+        if type(flag) != "string":
+            codegen_option_follows = False
+            continue
+        option = None
+        if codegen_option_follows:
+            option = flag
+        elif flag.startswith("-C"):
+            option = flag.removeprefix("-C")
+        elif flag.startswith("--codegen="):
+            option = flag.removeprefix("--codegen=")
+        codegen_option_follows = flag in ("-C", "--codegen")
+        if option and option.startswith("strip="):
+            strip_level = option.removeprefix("strip=")
+    return strip_level
+
+def _cc_common_link_strip_symbols_flags(toolchain):
+    """The link flags that strip the symbols, as rustc does for `-Cstrip=symbols`.
+
+    The strip of the debug info comes from the cc toolchain. An MSVC link keeps the symbols only in the PDB, so a link
+    without debug info needs no other flag.
+
+    Args:
+        toolchain (rust_toolchain): The current Rust toolchain.
+
+    Returns:
+        list[str]: The link flags.
+    """
+    if toolchain.target_abi == "msvc":
+        return []
+    if toolchain.target_os in ("darwin", "macos", "ios"):
+        # rustc runs `strip -x`, which keeps the global symbols that a dynamic link needs.
+        return ["-Wl,-x"]
+    return ["-Wl,--strip-all"]
+
