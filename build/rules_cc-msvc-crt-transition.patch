diff --git a/cc/private/rules_impl/msvc_crt_transition.bzl b/cc/private/rules_impl/msvc_crt_transition.bzl
new file mode 100644
--- /dev/null
+++ b/cc/private/rules_impl/msvc_crt_transition.bzl
@@ -0,0 +1,22 @@
+"""Applies the MSVC C runtime mode that a linking target asks for to its whole configuration."""
+
+_FEATURES = "//command_line_option:features"
+
+# The toolchain enables `dynamic_link_msvcrt` by default, and both features select the same CRT mode.
+_STATIC_MSVC_CRT_FEATURES = ["static_link_msvcrt", "-dynamic_link_msvcrt"]
+
+def _msvc_crt_transition_impl(settings, attr):
+    features = settings["//command_line_option:features"]
+    if "static_link_msvcrt" not in attr.features:
+        return {_FEATURES: features}
+    return {_FEATURES: features + [feature for feature in _STATIC_MSVC_CRT_FEATURES if feature not in features]}
+
+# A toolchain can select the CRT mode only from `--features`, for each configuration. The MSVC toolchain of `@llvm`
+# does, and it builds one libc++ archive for each configuration in that mode. So a `static_link_msvcrt` feature on the
+# target alone would not change its link. This transition copies it to `--features`, so the whole dependency graph of
+# the target takes the same CRT mode. A target without the feature keeps its configuration.
+msvc_crt_transition = transition(
+    implementation = _msvc_crt_transition_impl,
+    inputs = [_FEATURES],
+    outputs = [_FEATURES],
+)
